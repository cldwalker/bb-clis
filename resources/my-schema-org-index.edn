{:graph-namespace :schema,
 :classes
 {:Service
  #:build{:properties
          #:tagaholic.me{:meta
                         "Haven't fully defined why most web-apps don't fall under this"}},
  :PodcastSeries #:build{:alias [:Podcast]},
  :VideoObject #:build{:alias [:Video]},
  :DigitalDocument #:build{:alias [:Doc]},
  :IndividualProduct #:build{:alias [:IProduct]},
  :WebSite #:build{:alias [:Site]},
  :Invoice #:build{:alias [:Bill]},
  :BusinessEvent #:build{:alias [:Meeting]},
  :Brand
  #:build{:properties
          #:tagaholic.me{:meta
                         "I'll probably mostly use it as a product group. Torn about using this vs product for some cases"}},
  :SoftwareSourceCode #:build{:alias [:Repository]},
  :ScholarlyArticle #:build{:alias [:Paper]},
  :SocialMediaPosting #:build{:alias []},
  :Quotation #:build{:alias [:Quote]},
  :WebApplication #:build{:alias [:WebApp]},
  :Text
  #:build{:alias [:String],
          :properties
          #:tagaholic.me{:meta
                         "Prefer the name string over text as it maps with xsd:string"}},
  :Date
  #:build{:properties
          #:tagaholic.me{:meta
                         "Does not have the same date format as schema.org"}},
  :SoftwareApplication #:build{:alias [:App]},
  :Corporation #:build{:alias [:Company]},
  :Time
  #:build{:properties
          #:tagaholic.me{:meta
                         "Almost has the same format as seconds are optional"}},
  :CollegeOrUniversity #:build{:alias [:University]},
  :Question
  #:build{:alias [:Q],
          :class-properties [:tagaholic.me.property/answer]},
  :URL
  #:build{:alias [:Uri],
          :properties
          #:tagaholic.me{:meta
                         "Couldn't use URL since we're case insensitive and url is already taken"}},
  :ComputerLanguage #:build{:alias [:ProgrammingLanguage]},
  :MobileApplication #:build{:alias [:MobileApp]},
  :DataType
  #:build{:properties
          #:tagaholic.me{:meta
                         "Almost seems same as [rdfs:Datatype](https://www.w3.org/TR/rdf12-schema/#ch_datatype) but not quite because it inherits differently than schema version"}}},
 :properties
 {:logseq.property/description #:build{:alias []},
  :actionStatus #:build{:alias [:status]},
  :programmingLanguage #:build{:alias [:plang]},
  :about #:logseq.property{:ui-position :block-right},
  :attendee #:logseq.property{:ui-position :block-right}}}
