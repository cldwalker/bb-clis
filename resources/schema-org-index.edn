   :build/properties
   {:url "https://schema.org/RoofingContractor",
    :logseq.property/description "A roofing contractor."},
   :build/class-extends [:HomeAndConstructionBusiness]},
  :WebPage
  {:block/title "WebPage",
   :build/properties
   {:url "https://schema.org/WebPage",
    :logseq.property/description
    "A web page. Every web page is implicitly assumed to be declared to be of type WebPage, so the various properties about that webpage, such as <code>breadcrumb</code> may be used. We recommend explicit declaration if these properties are specified, but if they are found outside of an itemscope, they will be assumed to be about the page."},
   :build/class-extends [:CreativeWork],
   :build/class-properties
   [:mainContentOfPage
    :specialty
    :significantLink
    :relatedLink
    :primaryImageOfPage
    :breadcrumb
    :reviewedBy
    :speakable
    :lastReviewed]},
  :School
  {:block/title "School",
   :build/properties
   {:url "https://schema.org/School",
    :logseq.property/description "A school."},
   :build/class-extends [:EducationalOrganization]},
  :Pharmacy
  {:block/title "Pharmacy",
   :build/properties
   {:url "https://schema.org/Pharmacy",
    :logseq.property/description "A pharmacy or drugstore."},
   :build/class-extends [:MedicalOrganization :MedicalBusiness]},
  :MenuSection
  {:block/title "MenuSection",
   :build/properties
   {:url "https://schema.org/MenuSection",
    :logseq.property/description
    "A sub-grouping of food or drink items in a menu. E.g. courses (such as 'Dinner', 'Breakfast', etc.), specific type of dishes (such as 'Meat', 'Vegan', 'Drinks', etc.), or some other classification made by the menu provider."},
   :build/class-extends [:CreativeWork],
   :build/class-properties [:hasMenuItem :hasMenuSection]},
  :Grant
  {:block/title "Grant",
   :build/properties
   {:url "https://schema.org/Grant",
    :logseq.property/description
    "A grant, typically financial or otherwise quantifiable, of resources. Typically a [[funder]] sponsors some [[MonetaryAmount]] to an [[Organization]] or [[Person]],\n    sometimes not necessarily via a dedicated or long-lived [[Project]], resulting in one or more outputs, or [[fundedItem]]s. For financial sponsorship, indicate the [[funder]] of a [[MonetaryGrant]]. For non-financial support, indicate [[sponsor]] of [[Grant]]s of resources (e.g. office space).\n\nGrants support  activities directed towards some agreed collective goals, often but not always organized as [[Project]]s. Long-lived projects are sometimes sponsored by a variety of grants over time, but it is also common for a project to be associated with a single grant.\n\nThe amount of a [[Grant]] is represented using [[amount]] as a [[MonetaryAmount]].\n    "},
   :build/class-extends [:Intangible],
   :build/class-properties [:fundedItem :sponsor :funder]},
  :Answer
  {:block/title "Answer",
   :build/properties
   {:url "https://schema.org/Answer",
    :logseq.property/description
    "An answer offered to a question; perhaps correct, perhaps opinionated or wrong."},
   :build/class-extends [:Comment],
   :build/class-properties [:parentItem :answerExplanation]},
  :Audience
  {:block/title "Audience",
   :build/properties
   {:url "https://schema.org/Audience",
    :logseq.property/description
    "Intended audience for an item, i.e. the group for whom the item was created."},
   :build/class-extends [:Intangible],
   :build/class-properties [:geographicArea :audienceType]},
  :LinkRole
  {:block/title "LinkRole",
   :build/properties
   {:url "https://schema.org/LinkRole",
    :logseq.property/description
    "A Role that represents a Web link, e.g. as expressed via the 'url' property. Its linkRelationship property can indicate URL-based and plain textual link types, e.g. those in IANA link registry or others such as 'amphtml'. This structure provides a placeholder where details from HTML's link element can be represented outside of HTML, e.g. in JSON-LD feeds."},
   :build/class-extends [:Role],
   :build/class-properties [:linkRelationship :inLanguage]},
  :BusStop
